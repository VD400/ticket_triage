# Development URLs. Never point TEST_DATABASE_URL at application/production data.
DATABASE_URL=postgresql+psycopg://triage@127.0.0.1:5432/ticket_triage
ASYNC_DATABASE_URL=postgresql://triage@127.0.0.1:5432/ticket_triage
READONLY_DB_URL=postgresql+psycopg://triage_readonly@127.0.0.1:5432/ticket_triage
TEST_DATABASE_URL=postgresql+psycopg://triage@127.0.0.1:5432/ticket_triage_test
REDIS_URL=redis://127.0.0.1:6379/0

# Enter real values securely in cloud environment settings, or an ignored .env.
JWT_SECRET_KEY=
GROQ_API_KEY=
COHERE_API_KEY=

# Local defaults; see ../DEPLOYMENT.md for Render and Vercel setup.
APP_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
EMAIL_BACKEND=console
# Production email: EMAIL_BACKEND=resend or smtp (never console).
EMAIL_FROM=
RESEND_API_KEY=
# SMTP alternative to Resend; TLS is required (465 SSL, otherwise STARTTLS).
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
